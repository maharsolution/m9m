        "options": {}
      },
      "id": "kafka-produce",
      "name": "Kafka Produce",
      "type": "n8n-nodes-base.kafka",
      "typeVersion": 1,
      "position": [
        260,
        300
      ],
      "credentials": {
        "kafka": {
          "id": "aiven-kafka-credential",
          "name": "Kafka - Aiven",
          "type": "kafka"
        }
      },
      "notes": "The credential envelope carries brokers / username / password / ca. The broker address, CA and login are also set as node parameters so the sample also works without a synced credential. The node output echoes the broker-assigned partition and offset."
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "respond-produce",
      "name": "Respond",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        520,
        300
      ]
    }
  ],
  "connections": {
    "Produce Webhook": {
      "main": [
        [
          {
            "node": "Build Payload",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build Payload": {
      "main": [
        [
          {
            "node": "Kafka Produce",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Kafka Produce": {
      "main": [
        [
          {
            "node": "Respond",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "versionId": "1"
}

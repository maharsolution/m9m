{
  "name": "Aiven Kafka - Produce (Native TLS + SASL)",
  "description": "Produce a message to an Aiven Kafka topic over native TLS (segmentio/kafka-go) using the project CA and SASL/PLAIN. Trigger it with a POST to /webhook/aiven-produce.",
  "category": "messaging",
  "difficulty": "beginner",
  "estimatedTime": "5 minutes",
  "prerequisites": [
    "An Aiven Kafka service (native endpoint on port 20475)",
    "The service CA certificate (kafkacert.crt)",
    "A topic that already exists in the service"
  ],
  "learningObjectives": [
    "Connect to a Kafka broker over native TLS with a custom CA",
    "Authenticate with SASL/PLAIN using a credential envelope",
    "Publish the webhook payload to a topic and read back the produce metadata"
  ],
  "nodes": [
    {
      "parameters": {
        "path": "/webhook/aiven-produce",
        "httpMethod": "POST",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "aiven-produce-webhook",
      "name": "Produce Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        -260,
        300
      ],
      "webhookId": "aiven-kafka-produce"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "field-topic",
              "name": "topic",
              "value": "={{ $json.body.topic || 'finnet-queue' }}",
              "type": "string"
            },
            {
              "id": "field-key",
              "name": "key",
              "value": "={{ $json.body.id || $json.body.key || 'sample-key' }}",
              "type": "string"
            },
            {
              "id": "field-value",
              "name": "value",
              "value": "={{ $json.body }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "build-payload",
      "name": "Build Payload",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "mode": "native",
        "brokers": "kafka-2366031f-tds-024f.a.aivencloud.com:20475",
        "topic": "={{ $json.topic }}",
        "key": "={{ $json.key }}",
        "value": "={{ $json.value }}",
        "saslMechanism": "PLAIN",
        "saslUsername": "avnadmin",
        "tls": true,

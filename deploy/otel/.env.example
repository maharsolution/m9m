# Sanitized OpenTelemetry defaults for m9m.
#
# This file is the template an operator copies to `.env` and edits
# in place. It is tracked in git because it contains *no secrets* —
# only the OTLP endpoint and the public, vendor-neutral knobs. Real
# secrets (API keys, collector tokens) live in
# `M9M_OTEL_EXPORTER_OTLP_HEADERS` or
# `M9M_OTEL_EXPORTER_OTLP_HEADERS_FILE` and are intentionally left
# blank below so a careless `cat` cannot leak them.
#
# Precedence (see docs/opentelemetry.MD §1.1):
#   1. m9m-specific M9M_OTEL_* wins over the bare OTel SDK names.
#   2. Bare OTel SDK names (OTEL_EXPORTER_OTLP_ENDPOINT, ...) work
#      out of the box so an existing OTel-style config block can be
#      reused as-is.
#   3. DB override via PUT /api/v1/otel wins over the env file.

# ---------------------------------------------------------------------------
# 1. Master switch + collector endpoint
# ---------------------------------------------------------------------------

export M9M_OTEL_ENABLED=true

# gRPC (port 4317) or http/protobuf (port 4318).
export M9M_OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
export M9M_OTEL_EXPORTER_OTLP_ENDPOINT=http://<collector-host>:4318

# Resource attributes — replace with your service identity.
export M9M_OTEL_SERVICE_NAME=m9m
export M9M_OTEL_SERVICE_VERSION=1.0.0

# ---------------------------------------------------------------------------
# 2. Auth (only when the collector requires it)
# ---------------------------------------------------------------------------

# Pick ONE — both are merged into every OTLP request header.
#
# export M9M_OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <token>"
# export M9M_OTEL_EXPORTER_OTLP_HEADERS_FILE=/etc/m9m/otel-headers.json

# ---------------------------------------------------------------------------
# 3. Volume knobs
# ---------------------------------------------------------------------------

# TraceIDRatioBased ratio (0.0 ... 1.0). 1.0 = sample every trace.
export M9M_OTEL_TRACES_SAMPLE_RATE=1.0

# When true, dev/test execution modes are dropped at sampling time.
export M9M_OTEL_TRACES_PRODUCTION_ONLY=true

# Emit per-node spans. Disable to reduce span volume; the workflow
# root + AI agent spans are still emitted.
export M9M_OTEL_TRACES_INCLUDE_NODE_SPANS=true

# Inject traceparent into outbound HTTP requests emitted by the
# HTTP Request node.
export M9M_OTEL_TRACES_INJECT_OUTBOUND=true

# ---------------------------------------------------------------------------
# 4. AI agent tracing (independent of #1)
# ---------------------------------------------------------------------------

export M9M_AGENTS_TRACING_ENABLED=true

# Privacy gates — leave OFF by default. Opt in only when the
# collector is GDPR-compliant and you have an explicit business
# reason to record LLM traffic.
export M9M_AGENTS_TRACING_RECORD_INPUTS=false
export M9M_AGENTS_TRACING_RECORD_OUTPUTS=false

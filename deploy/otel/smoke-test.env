# OTLP smoke-test env file for m9m
#
# Source this file before running `m9m serve` to enable OpenTelemetry
# exports to an OTLP-compatible collector. This file is intentionally
# vendor-neutral — point it at Jaeger, SigNoz, Tempo, Honeycomb,
# Datadog, New Relic, or any other OTLP receiver.
#
# Layout:
#   1. Master switch + collector endpoint
#   2. Auth (optional — depends on your collector)
#   3. Volume knobs (sampling, node spans, propagation)
#   4. AI agent tracing (independent of #1)
#
# After running a workflow, look for the new service
# `m9m` (or whatever `M9M_OTEL_SERVICE_NAME` says) in your backend's
# traces UI. Seeing at least one `workflow.execute` span is success.

# ---------------------------------------------------------------------------
# 1. Master switch + collector endpoint
# ---------------------------------------------------------------------------

# Flip to true once your collector is reachable.
export M9M_OTEL_ENABLED=true

# Pick gRPC (default for most collectors) or http/protobuf.
# - grpc:          M9M_OTEL_ENDPOINT=host:4317
# - http/protobuf: M9M_OTEL_ENDPOINT=http://host:4318  (path /v1/traces is appended automatically)
export M9M_OTEL_PROTOCOL=grpc
export M9M_OTEL_ENDPOINT=127.0.0.1:4317

# Resource attributes. Most collectors ingest these without extra config.
export M9M_OTEL_SERVICE_NAME=m9m
export M9M_OTEL_SERVICE_VERSION=1.0.0

# ---------------------------------------------------------------------------
# 2. Auth (only when your collector requires it)
# ---------------------------------------------------------------------------

# Pick ONE of the two — both are merged into the OTLP request headers.

# Single-header shortcut (Bearer-style).
# export M9M_OTEL_HEADERS="Authorization=Bearer xyz"

# Multi-header dict — preferred for secret values (gitignore the file).
# export M9M_OTEL_HEADERS_FILE=/etc/m9m/otel-headers.json
# Contents:
#   {
#     "Authorization": "Bearer xyz",
#     "x-honeycomb-team": "..."
#   }

# ---------------------------------------------------------------------------
# 3. Volume knobs
# ---------------------------------------------------------------------------

# TraceIDRatioBased ratio (0.0 ... 1.0). 1.0 = sample every trace.
export M9M_OTEL_SAMPLE_RATE=1.0

# When true, dev / test execution modes are dropped at sampling time even if
# their trace IDs are rolled in.
export M9M_OTEL_PRODUCTION_ONLY=false

# Emit per-node spans (every node.execute). Disable to reduce span volume;
# the workflow root + the AI agent spans are still emitted.
export M9M_OTEL_INCLUDE_NODE_SPANS=true

# Inject the active traceparent into outbound HTTP requests emitted by the
# HTTP Request node. Set to false to keep the workflow private.
export M9M_OTEL_INJECT_OUTBOUND=true

# ---------------------------------------------------------------------------
# 4. AI agent tracing (independent of #1)
# ---------------------------------------------------------------------------

# Master switch for AI agent spans. Turn on after the basic pipeline works.
export M9M_AGENTS_TRACING_ENABLED=false

# Privacy gates — leave OFF by default. Opt-in only when your collector
# is GDPR-compliant and you have an explicit business reason to record
# LLM traffic.
export M9M_AGENTS_TRACING_RECORD_INPUTS=false
export M9M_AGENTS_TRACING_RECORD_OUTPUTS=false

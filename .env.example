# m9m backend uses MySQL.
# DSN format: user:pass@tcp(host:port)/db?parseTime=true&charset=utf8mb4
# parseTime=true is REQUIRED — m9m scans TIMESTAMP into time.Time.
# charset=utf8mb4 is REQUIRED — full unicode + emoji support.
M9M_MYSQL_DSN=m9m_admin:Secure_Db_Pass_2026@tcp(mysql-db:3306)/m9m_prod?parseTime=true&charset=utf8mb4&loc=UTC
M9M_DB_NAME=m9m_prod

# MySQL root + admin (consumed by mysql-db container at first init)
DB_MYSQL_ROOT_PASSWORD=Secure_Root_Pass_2026
DB_MYSQL_USER=m9m_admin
DB_MYSQL_PASSWORD=Secure_Db_Pass_2026

# n8n (uses Postgres — n8n does not support MySQL)
DB_POSTGRESDB_USER=database_admin
DB_POSTGRESDB_PASSWORD=Secure_Db_Pass_2026
DB_POSTGRESDB_DATABASE=n8n_prod

# n8n encryption key (use a long random string in production)
GEN_ENCRYPTION_KEY=Default_Secure_Key_Change_Me_!!!

# n8n REST API key. Create it in the n8n UI: Settings → API → Create API Key.
# The sync service aborts if this is not set.
N8N_API_KEY=set-this-in-n8n-ui-and-paste-here
